<UserControl x:Class="Unbounded.Panorama.App.Views.LightingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Unbounded.Panorama.App.ViewModels"
             xmlns:controls="clr-namespace:Unbounded.Panorama.App.Controls">
    <UserControl.Resources>
        <Style x:Key="TypePill" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="#1A00E5FF" />
            <Setter Property="BorderBrush" Value="#5500E5FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <!-- A colour dot that syncs everything to its colour (Tag) -->
        <Style x:Key="QuickSync" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Sync everything to this colour" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse x:Name="e" Stroke="#40FFFFFF" StrokeThickness="1">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="e" Property="Stroke" Value="{StaticResource Accent}" />
                                <Setter TargetName="e" Property="StrokeThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Banner" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,6,16,16" DataContext="{Binding Lighting}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="4,4,4,14">
            <Button Content="Refresh" Style="{StaticResource Chip}" Margin="0" DockPanel.Dock="Right" VerticalAlignment="Center" Command="{Binding RefreshCommand}" />
            <StackPanel>
                <TextBlock Text="LIGHTING" Style="{StaticResource Kicker}" />
                <TextBlock Text="ARGB" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- What stands in the way -->
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource Banner}" Background="#1AFF4D6D" BorderBrush="#66FF4D6D"
                    Visibility="{Binding OpenRgbMissing, Converter={StaticResource Visible}}">
                <DockPanel>
                    <Button Content="Install OpenRGB" Style="{StaticResource Primary}" DockPanel.Dock="Right" VerticalAlignment="Center" Padding="16,6"
                            Command="{Binding InstallOpenRgbCommand}" />
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Run Text="OpenRGB is needed." FontWeight="SemiBold" />
                        <Run Text="This free, open source service detects and drives RGB devices of every major brand (motherboards, RAM, graphics cards, fans, keyboards…). It installs like FFmpeg, through winget." Foreground="{StaticResource Muted}" />
                    </TextBlock>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Banner}" Background="#1AFFC247" BorderBrush="#66FFC247"
                    Visibility="{Binding ArmouryLightingRunning, Converter={StaticResource Visible}}">
                <DockPanel>
                    <Button Content="Turn off Armoury Crate lighting" Style="{StaticResource Primary}" DockPanel.Dock="Right" VerticalAlignment="Center" Padding="16,6"
                            Command="{Binding DisableArmouryLightingCommand}" />
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Run Text="Armoury Crate's lighting service is running." FontWeight="SemiBold" />
                        <Run Text="It keeps rewriting the ASUS lighting, so your colours here would flicker or revert. This turns off only its lighting service; fans, updates and the rest of Armoury Crate are untouched." Foreground="{StaticResource Muted}" />
                    </TextBlock>
                </DockPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Sync -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ALL DEVICES" Style="{StaticResource SectionTitle}" />
                            <CheckBox Content="Sync everything to one look" IsChecked="{Binding SyncEnabled}" Margin="0,12,0,0" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Dim}" FontSize="11" Margin="0,4,0,10"
                                       Text="Every device follows this, except the ones you take out of sync on their card." />
                            <TextBlock Text="Effect" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding SyncEffects}" SelectedItem="{Binding SyncEffect}" />
                            <StackPanel Visibility="{Binding SyncUsesColor, Converter={StaticResource Visible}}" Margin="0,10,0,0">
                                <TextBlock Text="Colour" Style="{StaticResource Label}" />
                                <controls:ColorPicker Hex="{Binding SyncColor, Mode=TwoWay}" />
                            </StackPanel>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource QuickSync}" Tag="#FFFFFF" Command="{Binding SyncToCommand}" CommandParameter="#FFFFFF" />
                                <Button Style="{StaticResource QuickSync}" Tag="#FF0000" Command="{Binding SyncToCommand}" CommandParameter="#FF0000" />
                                <Button Style="{StaticResource QuickSync}" Tag="#FF7A00" Command="{Binding SyncToCommand}" CommandParameter="#FF7A00" />
                                <Button Style="{StaticResource QuickSync}" Tag="#FFD000" Command="{Binding SyncToCommand}" CommandParameter="#FFD000" />
                                <Button Style="{StaticResource QuickSync}" Tag="#00FF40" Command="{Binding SyncToCommand}" CommandParameter="#00FF40" />
                                <Button Style="{StaticResource QuickSync}" Tag="#00E5FF" Command="{Binding SyncToCommand}" CommandParameter="#00E5FF" />
                                <Button Style="{StaticResource QuickSync}" Tag="#0040FF" Command="{Binding SyncToCommand}" CommandParameter="#0040FF" />
                                <Button Style="{StaticResource QuickSync}" Tag="#8B5CF6" Command="{Binding SyncToCommand}" CommandParameter="#8B5CF6" />
                                <Button Style="{StaticResource QuickSync}" Tag="#FF00C8" Command="{Binding SyncToCommand}" CommandParameter="#FF00C8" />
                            </WrapPanel>
                            <StackPanel Visibility="{Binding SyncUsesSpeed, Converter={StaticResource Visible}}" Margin="0,10,0,0">
                                <DockPanel>
                                    <TextBlock Text="{Binding SyncSpeed, StringFormat={}{0}%}" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" FontSize="12" />
                                    <TextBlock Text="Speed" Style="{StaticResource Label}" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="100" Value="{Binding SyncSpeed}" IsSnapToTickEnabled="True" TickFrequency="1" />
                            </StackPanel>
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock Text="{Binding SyncBrightness, StringFormat={}{0}%}" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" FontSize="12" />
                                <TextBlock Text="Brightness" Style="{StaticResource Label}" />
                            </DockPanel>
                            <Slider Minimum="0" Maximum="100" Value="{Binding SyncBrightness}" IsSnapToTickEnabled="True" TickFrequency="1" />
                        </StackPanel>
                    </Border>

                    <!-- Profiles -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="PROFILES" Style="{StaticResource SectionTitle}" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Dim}" FontSize="11" Margin="0,4,0,10"
                                       Text="Your current lighting is always kept and comes back when the PC starts. Profiles store looks to switch between." />
                            <DockPanel>
                                <Button Content="Delete" Style="{StaticResource Chip}" DockPanel.Dock="Right" Command="{Binding DeleteProfileCommand}" />
                                <Button Content="Load" Style="{StaticResource Chip}" DockPanel.Dock="Right" Command="{Binding LoadProfileCommand}" />
                                <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfile}" />
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <Button Content="Save" Style="{StaticResource Chip}" DockPanel.Dock="Right" Command="{Binding SaveProfileCommand}" />
                                <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Name of the profile to save" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Keep it on the hardware -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="KEEP IT ON THE DEVICES" Style="{StaticResource SectionTitle}" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,10"
                                       Text="Stores the current effects in the devices that have memory for it (your motherboard does), so they show before Windows starts and even with the app closed. Use it when you are happy with a look: it writes to the device's memory." />
                            <Button Content="Save to devices" Style="{StaticResource Chip}" HorizontalAlignment="Left" Command="{Binding SaveToDevicesCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Devices -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RgbDeviceViewModel}">
                            <Border Style="{StaticResource Card}" Width="400" Margin="0,0,16,16" VerticalAlignment="Top">
                                <StackPanel>
                                    <Border Style="{StaticResource TypePill}">
                                        <TextBlock Text="{Binding TypeLabel}" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Accent}" />
                                    </Border>
                                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="17" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="11.5" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <CheckBox Content="Control with this app" IsChecked="{Binding Enabled}" Margin="0,0,16,0"
                                                  ToolTip="Off: the app never touches this device (leave it to its own software)" />
                                        <CheckBox Content="Follow sync" IsChecked="{Binding InSync}" IsEnabled="{Binding Enabled}"
                                                  Visibility="{Binding DataContext.SyncEnabled, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Visible}}" />
                                    </WrapPanel>
                                    <TextBlock Text="Following the ALL DEVICES look." Foreground="{StaticResource Accent}" FontSize="12" Margin="0,10,0,0"
                                               Visibility="{Binding Following, Converter={StaticResource Visible}}" />

                                    <!-- Its own look -->
                                    <StackPanel Visibility="{Binding Editable, Converter={StaticResource Visible}}" Margin="0,10,0,0">
                                        <TextBlock Text="Effect" Style="{StaticResource Label}" />
                                        <ComboBox ItemsSource="{Binding Effects}" SelectedItem="{Binding Effect}" />
                                        <StackPanel Visibility="{Binding UsesColor, Converter={StaticResource Visible}}" Margin="0,10,0,0">
                                            <TextBlock Text="Colour" Style="{StaticResource Label}" />
                                            <controls:ColorPicker Hex="{Binding Color, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding UsesSpeed, Converter={StaticResource Visible}}" Margin="0,10,0,0">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Speed, StringFormat={}{0}%}" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" FontSize="12" />
                                                <TextBlock Text="Speed" Style="{StaticResource Label}" />
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="100" Value="{Binding Speed}" IsSnapToTickEnabled="True" TickFrequency="1" />
                                        </StackPanel>
                                        <DockPanel Margin="0,10,0,0">
                                            <TextBlock Text="{Binding Brightness, StringFormat={}{0}%}" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" FontSize="12" />
                                            <TextBlock Text="Brightness" Style="{StaticResource Label}" />
                                        </DockPanel>
                                        <Slider Minimum="0" Maximum="100" Value="{Binding Brightness}" IsSnapToTickEnabled="True" TickFrequency="1" />
                                    </StackPanel>

                                    <!-- Zones -->
                                    <TextBlock Text="ZONES" Style="{StaticResource Label}" Margin="0,14,0,4" IsEnabled="{Binding Enabled}" />
                                    <ItemsControl ItemsSource="{Binding Zones}" IsEnabled="{Binding Enabled}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:RgbZoneViewModel}">
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding LedText}" DockPanel.Dock="Right" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Name}" />
                                                        </DockPanel>
                                                        <!-- ARGB header: how many LEDs are plugged in -->
                                                        <StackPanel Visibility="{Binding Resizable, Converter={StaticResource Visible}}" Margin="0,6,0,0">
                                                            <DockPanel>
                                                                <TextBox Text="{Binding LedCount, Delay=400, UpdateSourceTrigger=PropertyChanged}" Width="70" DockPanel.Dock="Right"
                                                                         ToolTip="Number of LEDs connected (0 = nothing). The header lights exactly this many, so you can see when it covers everything." />
                                                                <TextBlock Text="LEDs connected" Foreground="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center" />
                                                            </DockPanel>
                                                            <DockPanel Margin="0,6,0,0">
                                                                <TextBox Text="{Binding Label, Delay=600, UpdateSourceTrigger=PropertyChanged}" Width="170" DockPanel.Dock="Right" ToolTip="Your name for what is plugged in, e.g. Fan hub" />
                                                                <TextBlock Text="Name" Foreground="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center" />
                                                            </DockPanel>
                                                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Dim}" FontSize="10.5" Margin="0,4,0,0">
                                                                <Run Text="A header cannot tell what is plugged in: enter the LEDs of what is on it (up to" /> <Run Text="{Binding MaxLeds, Mode=OneWay}" /><Run Text="). Fans chained one after another add up; a fan hub repeats the signal on each port, so count its longest chain. A hub with a remote must be switched to motherboard sync on the remote." />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <!-- Its own colour (Static, when the device has its own look) -->
                                                        <StackPanel Margin="0,6,0,0"
                                                                    Visibility="{Binding DataContext.ZoneColorsApply, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}, Converter={StaticResource Visible}}"
                                                                    IsEnabled="{Binding DataContext.Editable, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}">
                                                            <CheckBox Content="Its own colour" IsChecked="{Binding HasOwnColor}" FontSize="11.5" />
                                                            <controls:ColorPicker Hex="{Binding Color, Mode=TwoWay}" Margin="0,6,0,0"
                                                                                  Visibility="{Binding HasOwnColor, Converter={StaticResource Visible}}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

<Window x:Class="Unbounded.Panorama.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Unbounded.Panorama.App.Views"
        Title="Unbounded Panorama 360" Width="1560" Height="960" MinWidth="1240" MinHeight="720"
        Background="Transparent" WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="58" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Root">
        <!-- Semi-opaque base over the Mica backdrop, with an ambient cyan/violet glow. -->
        <Grid Background="#E605070D">
            <Border Background="{StaticResource Ambient}" IsHitTestVisible="False" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ====================================================== title bar -->
                <Grid Margin="16,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Logo + wordmark -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="30" Height="38" Margin="4,0,12,0">
                            <Border CornerRadius="8" Background="{StaticResource AccentGradient}" Effect="{StaticResource Glow}" />
                            <Border CornerRadius="5" Margin="5" Background="#05070D" />
                            <Border CornerRadius="2" Height="3" Margin="10,0,10,4" VerticalAlignment="Center" Background="{StaticResource Accent}" />
                            <Border CornerRadius="2" Height="3" Margin="10,12,13,0" VerticalAlignment="Center" Background="#8B5CF6" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="19" Margin="0,-2,0,-4">
                                <Run Text="UNBOUNDED" /><Run Text=" PANORAMA" Foreground="{StaticResource Accent}" /><Run Text=" 360" Foreground="#8B5CF6" />
                            </TextBlock>
                            <TextBlock Text="ANYTHING · ANYWHERE · ON YOUR COOLER" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource Dim}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Device status + live temps -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="34,0,0,0">
                        <Border Background="{StaticResource Glass2}" BorderBrush="{StaticResource EdgeGradient}" BorderThickness="1" CornerRadius="16" Padding="14,6">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Ellipse Fill="{Binding EngineState, Converter={StaticResource StateBrush}}">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#3DDC97" BlurRadius="10" ShadowDepth="0" Opacity="0.9" />
                                        </Ellipse.Effect>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:1.1" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                </Grid>
                                <TextBlock Text="{Binding EngineDetail}" FontSize="12" VerticalAlignment="Center" />
                                <Border Width="1" Height="16" Background="{StaticResource Line}" Margin="12,0" />
                                <TextBlock FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center">
                                    <Run Text="CPU " Foreground="{StaticResource Muted}" /><Run Text="{Binding CpuTempText, Mode=OneWay}" Foreground="#FF7A59" />
                                    <Run Text="   GPU " Foreground="{StaticResource Muted}" /><Run Text="{Binding GpuTempText, Mode=OneWay}" Foreground="#3DDC97" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Button Content="Close KANALI" Style="{StaticResource Warn}" Margin="10,0,0,0" Command="{Binding CloseKanaliCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Visibility="{Binding IsKanaliBlocking, Converter={StaticResource Visible}}"
                                ToolTip="KANALI owns the cooler while it runs. Closing it lets this app take over." />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0">
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource Fg}" FontSize="12" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding ProgressDetail}" Foreground="{StaticResource Muted}" FontSize="11" FontFamily="Cascadia Mono, Consolas"
                                   HorizontalAlignment="Right" Visibility="{Binding ProgressDetail, Converter={StaticResource Visible}}" />
                    </StackPanel>

                    <Button Grid.Column="3" Style="{StaticResource Primary}" Command="{Binding ApplyCommand}" VerticalAlignment="Center" Margin="0,0,14,0"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Send the design, background and drawing to the cooler (Ctrl+Enter)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE724;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="#030712" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="APPLY TO COOLER" Foreground="#030712" FontFamily="{StaticResource Display}" FontWeight="Bold" />
                            <Ellipse Width="7" Height="7" Fill="#030712" Margin="8,0,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding BackgroundDirty, Converter={StaticResource Visible}}" ToolTip="Background or drawing changed since last apply" />
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Caption}" Content="&#xE921;" Click="OnMinimize" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimise" />
                        <Button x:Name="MaxButton" Style="{StaticResource Caption}" Content="&#xE922;" Click="OnMaximize" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximise" />
                        <Button Style="{StaticResource CaptionClose}" Content="&#xE8BB;" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close to tray" />
                    </StackPanel>
                </Grid>

                <!-- Apply progress: converting, then uploading -->
                <ProgressBar Height="3" VerticalAlignment="Bottom" Margin="16,0,16,0"
                             Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}"
                             Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />

                <!-- ====================================================== body -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Navigation rail -->
                    <StackPanel Margin="12,8,0,0">
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" Content="STUDIO" Tag="&#xEE56;"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource Is}, ConverterParameter=Studio}" />
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" Content="LIBRARY" Tag="&#xE8F1;"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource Is}, ConverterParameter=Library}"
                                     Checked="OnLibraryChecked" />
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" Content="SETTINGS" Tag="&#xE713;"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource Is}, ConverterParameter=Settings}" />
                    </StackPanel>

                    <Grid Grid.Column="1">
                        <views:StudioView x:Name="Studio" Style="{StaticResource Page}" Visibility="{Binding CurrentPage, Converter={StaticResource IsVisible}, ConverterParameter=Studio}" />
                        <views:LibraryView Style="{StaticResource Page}" Visibility="{Binding CurrentPage, Converter={StaticResource IsVisible}, ConverterParameter=Library}" />
                        <views:SettingsView Style="{StaticResource Page}" Visibility="{Binding CurrentPage, Converter={StaticResource IsVisible}, ConverterParameter=Settings}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

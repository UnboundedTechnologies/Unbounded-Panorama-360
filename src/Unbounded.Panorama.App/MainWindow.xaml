<Window x:Class="Unbounded.Panorama.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Unbounded.Panorama.App.ViewModels"
        xmlns:layout="clr-namespace:Unbounded.Panorama.Layout;assembly=Unbounded.Panorama.Core"
        Title="Unbounded Panorama 360" Width="1500" Height="940" MinWidth="1180" MinHeight="700"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <DataTemplate x:Key="EnumItem">
            <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
        </DataTemplate>
        <Style x:Key="Sep" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Background" Value="{StaticResource Line}" />
        </Style>
        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================ top bar -->
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="18" Height="28" CornerRadius="5" Background="{StaticResource AccentGradient}" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock Text="Unbounded Panorama 360" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Anything, anywhere on your cooler" FontSize="11" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                    <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="12,5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding EngineState, Converter={StaticResource StateBrush}}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding EngineDetail}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Button Content="Close KANALI" Style="{StaticResource Warn}" Margin="10,0,0,0" Command="{Binding CloseKanaliCommand}"
                            Visibility="{Binding IsKanaliBlocking, Converter={StaticResource Visible}}"
                            ToolTip="KANALI owns the cooler while it runs. Closing it lets this app take over." />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="3" Style="{StaticResource Primary}" Command="{Binding ApplyCommand}" VerticalAlignment="Center"
                        ToolTip="Send the design and background to the cooler (Ctrl+Enter)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Apply to cooler" Foreground="#06101F" FontWeight="SemiBold" />
                        <Ellipse Width="7" Height="7" Fill="#06101F" Margin="8,0,0,0" VerticalAlignment="Center"
                                 Visibility="{Binding BackgroundDirty, Converter={StaticResource Visible}}" ToolTip="Background changed since last apply" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="370" />
            </Grid.ColumnDefinitions>

            <!-- ======================================================== left panel -->
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">

                        <!-- Presets -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Presets" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Your saved designs and starter templates" Style="{StaticResource Label}" Margin="0,2,0,6" />
                                <DockPanel>
                                    <Button Content="Load" Style="{StaticResource Chip}" Margin="6,0,0,0" DockPanel.Dock="Right" Command="{Binding LoadPresetCommand}" />
                                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Display" />
                                </DockPanel>
                                <DockPanel Margin="0,8,0,0">
                                    <Button Content="Delete" Style="{StaticResource Chip}" Margin="6,0,0,0" DockPanel.Dock="Right" Command="{Binding DeletePresetCommand}"
                                            IsEnabled="{Binding CanDeletePreset}" />
                                    <Button Content="Save" Style="{StaticResource Chip}" Margin="6,0,0,0" DockPanel.Dock="Right" Command="{Binding SavePresetCommand}"
                                            ToolTip="Save the current design under this name (overwrites a preset with the same name)" />
                                    <TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Preset name" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Screen -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Screen" Style="{StaticResource SectionTitle}" />
                                <DockPanel Margin="0,10,0,4">
                                    <TextBlock Text="{Binding Brightness, StringFormat={}{0}%}" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11.5" />
                                    <TextBlock Text="Brightness" Foreground="{StaticResource Muted}" FontSize="11.5" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="100" Value="{Binding Brightness, Delay=200}" IsSnapToTickEnabled="True" TickFrequency="1" />
                                <CheckBox Content="Fahrenheit (°F)" IsChecked="{Binding Fahrenheit}" Margin="0,12,0,0" />
                                <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Background -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Background" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding BackgroundName}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,8" />
                                <WrapPanel>
                                    <Button Content="Choose file…" Style="{StaticResource Chip}" Command="{Binding ChooseBackgroundCommand}" />
                                    <Button Content="YouTube…" Style="{StaticResource Chip}" Click="OnImportYouTube" />
                                    <Button Content="Clear" Style="{StaticResource Chip}" Command="{Binding ClearBackgroundCommand}"
                                            Visibility="{Binding HasBackground, Converter={StaticResource Visible}}" />
                                </WrapPanel>
                                <TextBlock Text="Tip: drop an image, GIF or video file on this window, or press Ctrl+V with a copied YouTube link or file." Foreground="{StaticResource Muted}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <StackPanel Visibility="{Binding HasBackground, Converter={StaticResource Visible}}">
                                    <TextBlock Text="Sizing" Style="{StaticResource Label}" />
                                    <ComboBox ItemsSource="{Binding Fits}" SelectedItem="{Binding BackgroundFit}" ItemTemplate="{StaticResource EnumItem}" />
                                    <TextBlock Text="Framing — horizontal / vertical" Style="{StaticResource Label}" />
                                    <Slider Minimum="0" Maximum="1" Value="{Binding CropX, Delay=300}" ToolTip="Which part of a wide source fills the screen" />
                                    <Slider Minimum="0" Maximum="1" Value="{Binding CropY, Delay=300}" Margin="0,6,0,0" />
                                    <Grid Margin="0,4,0,0" Visibility="{Binding IsVideoBackground, Converter={StaticResource Visible}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Start in file (s)" Style="{StaticResource Label}" />
                                            <TextBox Text="{Binding StartSeconds, UpdateSourceTrigger=LostFocus}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Length (s, empty = all)" Style="{StaticResource Label}" />
                                            <TextBox Text="{Binding DurationSeconds, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Widgets -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{Binding WidgetCount}" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center" />
                                    <TextBlock Text="Widgets" Style="{StaticResource SectionTitle}" />
                                </DockPanel>
                                <WrapPanel Margin="0,8,0,4">
                                    <Button Content="+ Text" Style="{StaticResource Chip}" Command="{Binding AddWidgetCommand}" CommandParameter="{x:Static layout:WidgetContent.Text}" />
                                    <Button Content="+ Sensor" Style="{StaticResource Chip}" Command="{Binding AddWidgetCommand}" CommandParameter="{x:Static layout:WidgetContent.Sensor}" />
                                    <Button Content="+ Clock" Style="{StaticResource Chip}" Command="{Binding AddWidgetCommand}" CommandParameter="{x:Static layout:WidgetContent.Clock}" />
                                    <Button Content="+ Date" Style="{StaticResource Chip}" Command="{Binding AddWidgetCommand}" CommandParameter="{x:Static layout:WidgetContent.Date}" />
                                    <Button Content="+ CPU badge" Style="{StaticResource Chip}" Command="{Binding AddWidgetCommand}" CommandParameter="{x:Static layout:WidgetContent.CpuName}" />
                                    <Button Content="+ GPU badge" Style="{StaticResource Chip}" Command="{Binding AddWidgetCommand}" CommandParameter="{x:Static layout:WidgetContent.GpuName}" />
                                </WrapPanel>
                                <ItemsControl ItemsSource="{Binding Widgets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:WidgetViewModel}">
                                            <Border x:Name="row" CornerRadius="8" Padding="6,4" Margin="0,1" Background="Transparent" Cursor="Hand"
                                                    MouseLeftButtonDown="OnListRowClick" Tag="{Binding}">
                                                <DockPanel>
                                                    <Button Style="{StaticResource Tool}" Width="28" Height="26" DockPanel.Dock="Right"
                                                            Command="{Binding DataContext.ToggleLockedCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                            ToolTip="Lock (cannot be moved)">
                                                        <TextBlock x:Name="lock" Style="{StaticResource IconGlyph}" FontSize="12" Text="&#xE785;" Foreground="{StaticResource Muted}" />
                                                    </Button>
                                                    <Button Style="{StaticResource Tool}" Width="28" Height="26" DockPanel.Dock="Right"
                                                            Command="{Binding DataContext.ToggleHiddenCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                            ToolTip="Show / hide on the cooler">
                                                        <TextBlock x:Name="eye" Style="{StaticResource IconGlyph}" FontSize="12" Text="&#xE890;" Foreground="{StaticResource Muted}" />
                                                    </Button>
                                                    <Border Width="24" Height="24" CornerRadius="6" Background="#1F2838" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Kind}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{Binding ColorBrush}" />
                                                    </Border>
                                                    <TextBlock x:Name="title" Text="{Binding Title}" VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="#1D3B6E" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Hidden}" Value="True">
                                                    <Setter TargetName="eye" Property="Text" Value="&#xED1A;" />
                                                    <Setter TargetName="eye" Property="Foreground" Value="#FF7A59" />
                                                    <Setter TargetName="title" Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Locked}" Value="True">
                                                    <Setter TargetName="lock" Property="Text" Value="&#xE72E;" />
                                                    <Setter TargetName="lock" Property="Foreground" Value="#FFC247" />
                                                </DataTrigger>
                                                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource LineHover}" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ======================================================== canvas -->
            <Grid Grid.Column="1" Margin="20,14,20,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="6,4" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource Field}" CornerRadius="9">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="orient" IsChecked="{Binding IsPortrait}" ToolTip="Vertical — for a cooler mounted upright">Portrait</RadioButton>
                                <RadioButton Style="{StaticResource Segment}" GroupName="orient" IsChecked="{Binding IsLandscape}" ToolTip="Horizontal — the panel's native orientation">Landscape</RadioButton>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Sep}" />
                        <Button Style="{StaticResource Tool}" Command="{Binding AlignCommand}" CommandParameter="{x:Static vm:AlignMode.Left}" ToolTip="Align left (to the screen, or to each other when several are selected)">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IcoAlignLeft}" />
                        </Button>
                        <Button Style="{StaticResource Tool}" Command="{Binding AlignCommand}" CommandParameter="{x:Static vm:AlignMode.CenterH}" ToolTip="Centre horizontally">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IcoAlignCenterH}" />
                        </Button>
                        <Button Style="{StaticResource Tool}" Command="{Binding AlignCommand}" CommandParameter="{x:Static vm:AlignMode.Right}" ToolTip="Align right">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IcoAlignRight}" />
                        </Button>
                        <Button Style="{StaticResource Tool}" Command="{Binding AlignCommand}" CommandParameter="{x:Static vm:AlignMode.Top}" ToolTip="Align top">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IcoAlignTop}" />
                        </Button>
                        <Button Style="{StaticResource Tool}" Command="{Binding AlignCommand}" CommandParameter="{x:Static vm:AlignMode.Middle}" ToolTip="Centre vertically">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IcoAlignMiddle}" />
                        </Button>
                        <Button Style="{StaticResource Tool}" Command="{Binding AlignCommand}" CommandParameter="{x:Static vm:AlignMode.Bottom}" ToolTip="Align bottom">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IcoAlignBottom}" />
                        </Button>
                        <Border Style="{StaticResource Sep}" />
                        <Button Style="{StaticResource Tool}" Command="{Binding DistributeCommand}" CommandParameter="H" ToolTip="Distribute horizontally (equal gaps, 3+ selected)">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IcoDistH}" />
                        </Button>
                        <Button Style="{StaticResource Tool}" Command="{Binding DistributeCommand}" CommandParameter="V" ToolTip="Distribute vertically (equal gaps, 3+ selected)">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IcoDistV}" />
                        </Button>
                        <Button Style="{StaticResource Tool}" Command="{Binding MatchWidthCommand}" ToolTip="Same width as the last-clicked widget">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IcoMatchW}" />
                        </Button>
                        <Button Style="{StaticResource Tool}" Command="{Binding CenterOnScreenCommand}" CommandParameter="H" ToolTip="Centre the selection on the screen (keeps their spacing)">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IcoCenterScreen}" />
                        </Button>
                        <Border Style="{StaticResource Sep}" />
                        <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding SnapEnabled}" ToolTip="Magnet: snap to centre, edges, other widgets and equal spacing (hold Alt to move freely)">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IcoMagnet}" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding ShowCurveGuide}" ToolTip="Show where the screen bends">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IcoCurve}" />
                        </ToggleButton>
                        <Border Style="{StaticResource Sep}" />
                        <Button Style="{StaticResource Tool}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip="Undo (Ctrl+Z)">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE7A7;" />
                        </Button>
                        <Button Style="{StaticResource Tool}" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" ToolTip="Redo (Ctrl+Y)">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE7A6;" />
                        </Button>
                    </StackPanel>
                </Border>

                <Viewbox Grid.Row="1" Stretch="Uniform" Margin="0,14,0,0">
                    <Border CornerRadius="60" Background="#000000" BorderBrush="#2A3243" BorderThickness="10" ClipToBounds="True">
                        <Grid x:Name="Screen" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Background="Black" ClipToBounds="True"
                              MouseLeftButtonDown="OnScreenMouseDown" MouseMove="OnScreenMouseMove" MouseLeftButtonUp="OnScreenMouseUp" Focusable="True">
                            <Image Source="{Binding BackgroundPreview}" Stretch="Fill" IsHitTestVisible="False" />

                            <Grid IsHitTestVisible="False" Visibility="{Binding IsPortrait, Converter={StaticResource Visible}}">
                                <Grid Visibility="{Binding ShowCurveGuide, Converter={StaticResource Visible}}">
                                    <Line X1="0" X2="1080" Y1="1100" Y2="1100" Stroke="#5522D3EE" StrokeThickness="3" StrokeDashArray="8 8" />
                                    <TextBlock Text="screen bends here" Foreground="#8822D3EE" FontSize="26" Margin="16,1060,0,0" />
                                </Grid>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Widgets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:WidgetViewModel}">
                                        <Grid Width="{Binding Width}" Height="{Binding Height}" Opacity="{Binding Opacity}">
                                            <Grid x:Name="body" Background="Transparent" Tag="{Binding}" MouseLeftButtonDown="OnWidgetMouseDown" Cursor="SizeAll">
                                                <Border x:Name="sel" BorderThickness="3" BorderBrush="Transparent" CornerRadius="6" Margin="-6" />
                                                <Border Background="{Binding BadgeBrush}" CornerRadius="{Binding BadgeCorner}"
                                                        HorizontalAlignment="{Binding HorizontalAlign}" VerticalAlignment="Top">
                                                    <Border.Padding>
                                                        <MultiBinding Converter="{StaticResource BadgePadding}">
                                                            <Binding Path="Badge" />
                                                            <Binding Path="Size" />
                                                        </MultiBinding>
                                                    </Border.Padding>
                                                    <TextBlock Text="{Binding PreviewText}" Foreground="{Binding ColorBrush}" FontSize="{Binding Size}"
                                                               FontWeight="{Binding FontWeightValue}" FontFamily="{x:Static vm:WidgetViewModel.Roboto}"
                                                               TextOptions.TextFormattingMode="Ideal" TextWrapping="NoWrap" />
                                                </Border>
                                            </Grid>
                                            <Thumb x:Name="grip" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="24" Margin="0,0,-18,0" Cursor="SizeWE"
                                                   DragStarted="OnResizeStarted" DragDelta="OnResizeDelta" DragCompleted="OnResizeCompleted" Visibility="Collapsed">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="#4F8CFF" CornerRadius="6" Width="12" />
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="sel" Property="BorderBrush" Value="#4F8CFF" />
                                                <Setter TargetName="grip" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Locked}" Value="True">
                                                <Setter TargetName="body" Property="Cursor" Value="No" />
                                                <Setter TargetName="grip" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <Trigger SourceName="body" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="sel" Property="Background" Value="#144F8CFF" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Smart guides and the selection box are drawn here from code. -->
                            <Canvas x:Name="GuideLayer" IsHitTestVisible="False" />
                            <Canvas IsHitTestVisible="False">
                                <Rectangle x:Name="Marquee" Visibility="Collapsed" Fill="#224F8CFF" Stroke="#4F8CFF" StrokeThickness="3" StrokeDashArray="4 3" />
                            </Canvas>
                        </Grid>
                    </Border>
                </Viewbox>

                <DockPanel Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock Text="{Binding DragInfo}" DockPanel.Dock="Right" FontSize="11.5" Foreground="{StaticResource Accent2}" FontFamily="Cascadia Mono, Consolas" />
                    <TextBlock FontSize="11.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                               Text="Drag to move · Ctrl-click or drag a box to multi-select · Alt = no magnet · arrows nudge (Shift ×10) · Ctrl+Z / Ctrl+Y · Ctrl+D duplicate · Del removes · Ctrl+wheel text size · Ctrl+V paste a link or file" />
                </DockPanel>
            </Grid>

            <!-- ======================================================== right panel -->
            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="150" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="20" Visibility="{Binding SelectedWidget, Converter={StaticResource Hidden}}">
                        <TextBlock Text="Nothing selected" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Click a widget on the screen to edit it, Ctrl-click to select several, or add one from the left." Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedWidget, Converter={StaticResource Visible}}">
                        <StackPanel Margin="14">
                            <Border Style="{StaticResource Card}" Background="#1A2A44" Visibility="{Binding HasMultiSelection, Converter={StaticResource Visible}}">
                                <TextBlock TextWrapping="Wrap" FontSize="12">
                                    <Run Text="{Binding SelectionCount, Mode=OneWay}" /><Run Text=" widgets selected. Use the toolbar to align, distribute or match widths; colours apply to all. Below edits the last one clicked." />
                                </TextBlock>
                            </Border>

                            <StackPanel DataContext="{Binding SelectedWidget}">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button Content="Delete" Style="{StaticResource Chip}" Margin="6,0,0,0" DockPanel.Dock="Right"
                                                    Command="{Binding DataContext.DeleteWidgetCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Content="Duplicate" Style="{StaticResource Chip}" Margin="0" DockPanel.Dock="Right"
                                                    Command="{Binding DataContext.DuplicateWidgetCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <TextBlock Text="Content" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="Shows" Style="{StaticResource Label}" />
                                        <ComboBox ItemsSource="{Binding DataContext.ContentKinds, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding Content}" ItemTemplate="{StaticResource EnumItem}" />

                                        <StackPanel Visibility="{Binding IsTextContent, Converter={StaticResource Visible}}">
                                            <TextBlock Text="Text" Style="{StaticResource Label}" />
                                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                                        </StackPanel>

                                        <!-- Categorised sensor picker -->
                                        <StackPanel Visibility="{Binding IsSensorContent, Converter={StaticResource Visible}}">
                                            <TextBlock Text="Sensor" Style="{StaticResource Label}" />
                                            <TextBox Text="{Binding DataContext.SensorFilter, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                                     ToolTip="Search, e.g. “tctl”, “gpu core”, “fan”" />
                                            <ItemsControl ItemsSource="{Binding DataContext.SensorTypeChoices, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,8,0,2">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="sensorType" Content="{Binding}" Checked="OnSensorTypeChecked"
                                                                     Tag="{Binding}" Loaded="OnSensorTypeLoaded" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Background="{StaticResource Field}" Height="300" Margin="0,4,0,0">
                                                <ListBox ItemsSource="{Binding DataContext.SensorView, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         SelectedItem="{Binding DataContext.SelectedSensorRow, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource WidgetListItem}"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                                         VirtualizingPanel.IsVirtualizing="True" Padding="4">
                                                    <ListBox.GroupStyle>
                                                        <GroupStyle>
                                                            <GroupStyle.HeaderTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent2}" Margin="6,10,0,3" TextTrimming="CharacterEllipsis" />
                                                                </DataTemplate>
                                                            </GroupStyle.HeaderTemplate>
                                                        </GroupStyle>
                                                    </ListBox.GroupStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:SensorRow}">
                                                            <DockPanel>
                                                                <TextBlock Text="{Binding ValueText}" DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource Accent2}" Margin="8,0,0,0" />
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Type}" FontSize="10.5" Foreground="{StaticResource Muted}" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Decimals" Style="{StaticResource Label}" />
                                                    <TextBox Text="{Binding Decimals, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="2" Content="Show unit" IsChecked="{Binding ShowUnit}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding IsTimeContent, Converter={StaticResource Visible}}">
                                            <TextBlock Text="Format" Style="{StaticResource Label}" />
                                            <TextBox Text="{Binding Format, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                                            <WrapPanel Margin="0,6,0,0">
                                                <Button Content="HH:mm" Style="{StaticResource Chip}" Click="OnFormatPreset" />
                                                <Button Content="HH:mm:ss" Style="{StaticResource Chip}" Click="OnFormatPreset" />
                                                <Button Content="h:mm tt" Style="{StaticResource Chip}" Click="OnFormatPreset" />
                                                <Button Content="dddd d MMMM" Style="{StaticResource Chip}" Click="OnFormatPreset" />
                                                <Button Content="ddd d MMM" Style="{StaticResource Chip}" Click="OnFormatPreset" />
                                                <Button Content="dd/MM/yyyy" Style="{StaticResource Chip}" Click="OnFormatPreset" />
                                            </WrapPanel>
                                        </StackPanel>

                                        <Grid Visibility="{Binding UsesAffixes, Converter={StaticResource Visible}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Text before" Style="{StaticResource Label}" />
                                                <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Text after" Style="{StaticResource Label}" />
                                                <TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Style" Style="{StaticResource SectionTitle}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Weight" Style="{StaticResource Label}" />
                                                <ComboBox ItemsSource="{Binding DataContext.Weights, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Weight}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Text align in box" Style="{StaticResource Label}" />
                                                <ComboBox ItemsSource="{Binding DataContext.Aligns, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Align}" />
                                            </StackPanel>
                                        </Grid>
                                        <DockPanel Margin="0,10,0,4">
                                            <TextBlock Text="{Binding Size, StringFormat={}{0} px}" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11.5" />
                                            <TextBlock Text="Size" Foreground="{StaticResource Muted}" FontSize="11.5" />
                                        </DockPanel>
                                        <Slider Minimum="16" Maximum="400" Value="{Binding Size}" IsSnapToTickEnabled="True" TickFrequency="2" />

                                        <TextBlock Text="Colour" Style="{StaticResource Label}" />
                                        <DockPanel>
                                            <Border Width="32" Height="32" CornerRadius="8" Background="{Binding ColorBrush}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,8,0" />
                                            <TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding DataContext.Swatches, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,8,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="22" Height="22" Padding="0" Margin="0,0,6,6" Background="{Binding}" BorderThickness="0" ToolTip="{Binding}"
                                                            Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <CheckBox Content="Badge (gradient pill behind the text)" IsChecked="{Binding Badge}" Margin="0,8,0,0" />
                                        <StackPanel Visibility="{Binding Badge, Converter={StaticResource Visible}}">
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="From" Style="{StaticResource Label}" />
                                                    <TextBox Text="{Binding BadgeFrom, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="To" Style="{StaticResource Label}" />
                                                    <TextBox Text="{Binding BadgeTo, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                                                </StackPanel>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding DataContext.BadgePresets, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Width="40" Height="20" Padding="0" Margin="0,0,6,6" BorderThickness="0"
                                                                Command="{Binding DataContext.SetBadgePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                Background="{Binding Converter={x:Static vm:BadgePresetBrush.Instance}}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel>
                                            <CheckBox Content="Locked" IsChecked="{Binding Locked}" DockPanel.Dock="Right" />
                                            <TextBlock Text="Position on the cooler (px)" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="X" Style="{StaticResource Label}" />
                                                <TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Y" Style="{StaticResource Label}" />
                                                <TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Width" Style="{StaticResource Label}" />
                                                <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Activity log -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,10">
                        <DockPanel>
                            <TextBlock Text="Activity" Style="{StaticResource Label}" Margin="0,0,0,6" DockPanel.Dock="Top" />
                            <ListBox x:Name="Log" ItemsSource="{Binding LogLines}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource Muted}" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

<Window x:Class="Unbounded.Panorama.App.YouTubeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import from YouTube" Width="820" Height="780" MinWidth="660" MinHeight="660"
        Background="#05070D" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True" ShowInTaskbar="False">
    <Grid>
        <Border Background="{StaticResource Ambient}" IsHitTestVisible="False" />
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="IMPORT" Style="{StaticResource Kicker}" />
                <TextBlock Text="From YouTube" Style="{StaticResource PageTitle}" FontSize="26" />
                <TextBlock Text="Paste a link. The highest resolution YouTube offers is downloaded — only the part you choose." Foreground="{StaticResource Muted}"
                           FontSize="12.5" Margin="0,2,0,14" TextWrapping="Wrap" />
            </StackPanel>

            <DockPanel Grid.Row="1">
                <Button x:Name="FetchButton" Content="FETCH" Style="{StaticResource Primary}" DockPanel.Dock="Right" Margin="10,0,0,0" Padding="18,6"
                        Click="OnFetch" IsDefault="True" />
                <TextBox x:Name="UrlBox" FontSize="13" Height="36" />
            </DockPanel>

            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,12" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="Black" CornerRadius="10" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="Frame" Stretch="Uniform" />
                            <TextBlock x:Name="FrameHint" Text="Preview appears here" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="2,12,2,0">
                        <TextBlock x:Name="TitleText" FontSize="16" FontFamily="{StaticResource Display}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="MetaText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                        <TextBlock x:Name="BestText" Foreground="{StaticResource Accent}" FontSize="14" Margin="0,6,0,0" FontFamily="{StaticResource Display}" FontWeight="Bold" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="3" x:Name="RangePanel" Style="{StaticResource Card}" IsEnabled="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Start (minute:second)" Style="{StaticResource Label}" Margin="0,0,0,4" />
                    <Slider x:Name="StartSlider" Grid.Row="1" Minimum="0" Maximum="1" SmallChange="1" LargeChange="10" ValueChanged="OnStartSlider" VerticalAlignment="Center" />
                    <TextBox x:Name="StartBox" Grid.Row="1" Grid.Column="2" Text="0:00" LostFocus="OnStartBox" KeyDown="OnBoxKey" />
                    <TextBlock Grid.Row="2" Text="Length (seconds)" Style="{StaticResource Label}" />
                    <Slider x:Name="LengthSlider" Grid.Row="3" Minimum="3" Maximum="120" Value="30" SmallChange="1" LargeChange="5" ValueChanged="OnLengthSlider" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" />
                    <TextBox x:Name="LengthBox" Grid.Row="3" Grid.Column="2" Text="30" LostFocus="OnLengthBox" KeyDown="OnBoxKey" />
                </Grid>
            </Border>

            <!-- Progress -->
            <Border Grid.Row="4" x:Name="ProgressPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="ProgressPercent" DockPanel.Dock="Right" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource Accent}" />
                        <TextBlock x:Name="ProgressTitle" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                    </DockPanel>
                    <ProgressBar x:Name="Bar" Margin="0,10,0,8" />
                    <TextBlock x:Name="ProgressDetail" Foreground="{StaticResource Muted}" FontSize="12" FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <DockPanel Grid.Row="5">
                <Button x:Name="ImportButton" Content="DOWNLOAD &amp; USE AS BACKGROUND" Style="{StaticResource Primary}" DockPanel.Dock="Right" Click="OnImport" IsEnabled="False" />
                <Button x:Name="CancelButton" Content="Cancel" DockPanel.Dock="Right" Margin="0,0,10,0" Click="OnCancel" />
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>

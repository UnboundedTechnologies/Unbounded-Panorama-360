<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>UnboundedPanorama360</AssemblyName>
    <RootNamespace>Unbounded.Panorama.App</RootNamespace>
    <Product>Unbounded Panorama 360</Product>
    <Company>Unbounded Technologies</Company>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Program.Main relaunches elevated through the launcher task before WPF starts. -->
    <StartupObject>Unbounded.Panorama.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF app: keep WinForms types out of the global namespace (only NotifyIcon is used). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Unbounded.Panorama.Core\Unbounded.Panorama.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <None Include="Assets\Fonts\ROBOTO-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Fonts\RAJDHANI-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

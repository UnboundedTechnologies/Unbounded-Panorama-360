<Window x:Class="Unbounded.Panorama.App.AreaPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Where should it go?" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        Background="#05070D" WindowStartupLocation="CenterOwner" UseLayoutRounding="True" ShowInTaskbar="False">
    <Window.Resources>
        <!-- One choice: a small cooler with the target part lit, and its name -->
        <Style x:Key="AreaChoice" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="card" Width="150" Padding="16,18,16,14" CornerRadius="14" Background="{StaticResource Glass2}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1.5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="card" Property="Background" Value="#1A00E5FF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Cooler" TargetType="Border">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="116" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="#5A6478" />
            <Setter Property="Background" Value="#0A0E16" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid>
        <Border Background="{StaticResource Ambient}" IsHitTestVisible="False" />
        <StackPanel Margin="26,22,26,22">
            <TextBlock Text="PLACE IT" Style="{StaticResource Kicker}" />
            <TextBlock Text="Where should it go?" Style="{StaticResource PageTitle}" FontSize="24" />
            <TextBlock x:Name="FileText" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,2,0,18" TextTrimming="CharacterEllipsis" MaxWidth="520" HorizontalAlignment="Left" />

            <StackPanel Orientation="Horizontal" Margin="-8,0">
                <Button x:Name="WholeButton" Style="{StaticResource AreaChoice}" Click="OnWhole" ToolTip="Fills the whole screen (replaces both faces)">
                    <StackPanel>
                        <Border Style="{StaticResource Cooler}">
                            <Border Background="{StaticResource Accent}" Opacity="0.85" />
                        </Border>
                        <TextBlock Text="Whole screen" HorizontalAlignment="Center" Margin="0,12,0,0" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="Key W" HorizontalAlignment="Center" Foreground="{StaticResource Dim}" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button x:Name="TopButton" Style="{StaticResource AreaChoice}" Click="OnTop" ToolTip="The flat face above the bend; the front face keeps its media">
                    <StackPanel>
                        <Border Style="{StaticResource Cooler}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1100*" />
                                    <RowDefinition Height="1140*" />
                                </Grid.RowDefinitions>
                                <Border Background="{StaticResource Accent}" Opacity="0.85" />
                                <Border Grid.Row="1" BorderBrush="#5A6478" BorderThickness="0,1,0,0" />
                            </Grid>
                        </Border>
                        <TextBlock Text="Top face" HorizontalAlignment="Center" Margin="0,12,0,0" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="Key T" HorizontalAlignment="Center" Foreground="{StaticResource Dim}" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button x:Name="FrontButton" Style="{StaticResource AreaChoice}" Click="OnFront" ToolTip="The curved face below the bend; the top face keeps its media">
                    <StackPanel>
                        <Border Style="{StaticResource Cooler}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1100*" />
                                    <RowDefinition Height="1140*" />
                                </Grid.RowDefinitions>
                                <Border BorderBrush="#5A6478" BorderThickness="0,0,0,1" />
                                <Border Grid.Row="1" Background="{StaticResource Violet}" Opacity="0.9" />
                            </Grid>
                        </Border>
                        <TextBlock Text="Front face" HorizontalAlignment="Center" Margin="0,12,0,0" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="Key F" HorizontalAlignment="Center" Foreground="{StaticResource Dim}" FontSize="11" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Text="Top and front can each have their own image or video. Tip: drop files straight onto the top, middle or bottom of the screen preview."
                       Foreground="{StaticResource Dim}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="500" HorizontalAlignment="Left" Margin="0,18,0,0" />
            <Button Content="Cancel" Style="{StaticResource Chip}" HorizontalAlignment="Right" Margin="0,14,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>

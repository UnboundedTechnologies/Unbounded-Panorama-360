<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Unbounded.Panorama.Core\Unbounded.Panorama.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.13" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>unbounded-panorama</AssemblyName>
    <RootNamespace>Unbounded.Panorama.Server</RootNamespace>
    <Version>1.1.1</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- The cooler fonts (Roboto) and the app's display font (Rajdhani), shared with the Windows app. -->
  <ItemGroup>
    <None Include="..\Unbounded.Panorama.App\Assets\Fonts\*.*" Link="Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
